{
	"$schema"							: "http://json-schema.org/draft-04/schema#",
	"title"								: "Employer",
	"Description"						: "An employer is modelled as a set of employees making contributions to superannuation products. Products can be identified by ABN or USI.",
	"Version" : {
		"Major"							: 2,
		"Minor"							: 5,
		"Patch"							: 1
	},
	
	"type" : "object",
	"properties" : {
		"Profile"						: {"$ref" : "#/definitions/Profile/Profile"},
		"Entity"						: {"$ref" : "#/definitions/Entity/Entity"},
		"PayrollAdministration"			: {"$ref" : "#/definitions/PayrollAdministration/PayrollAdministration"},
		"Employees"						: {"$ref" : "#/definitions/Employees/Employees"},
		"ClearingHouses"				: {"$ref" : "#/definitions/ClearingHouses/ClearingHouses"},
		"SuperannuationProducts"		: {"$ref" : "#/definitions/SuperannuationProducts/SuperannuationProducts"}
	},
    "required"							: ["Profile", "Entity", "PayrollAdministration", "Employees", "SuperannuationProducts"],
        
	"definitions" : {
		"Types" : {
			"NonNegativeInteger"		: {"type" : "integer", "minimum" : 0},
		
			"MultipleOf8"				: {"allOf": [{"$ref" : "#/definitions/Types/NonNegativeInteger"}, { "multipleOf": 8}]},

			"NonEmptyString"			: {"type" : "string", "minLength" : 1},
		
			"URI"						: {"type" : "string", "format" : "uri", "minLength" : 1},
		
			"Email"						: {"type" : "string", "format" : "email"},

			"Boolean"					: {"type": "boolean"},
        
			"BooleanDefaultFalse"		: {"allOf": [{"$ref" : "#/definitions/Types/Boolean"}, { "default": false }]},
        
			"BooleanDefaultTrue"		: {"allOf": [{"$ref" : "#/definitions/Types/Boolean"}, { "default": true }]},
			
			"TimeUnit"					: {"enum" : ["seconds", "minutes", "hours", "days", "weeks"]}
		},
			
		"Profile" : {
			"Type"						: {"enum" : ["Employer"]},
			
			"Purpose"					: {"enum" : ["Positive", "Negative"], "default" : "Positive"},
			
			"Version" : {
				"type" : "object",
				"properties" : {
					"Major"				: {"$ref" : "#/definitions/Types/NonNegativeInteger"},
					"Minor"				: {"$ref" : "#/definitions/Types/NonNegativeInteger"},
					"Patch"				: {"$ref" : "#/definitions/Types/NonNegativeInteger"}
				},
				"required"				: ["Major", "Minor"]
			},
			
			"Profile" : {
				"type" : "object",
				"properties" : {
					"Type"				: {"$ref" : "#/definitions/Profile/Type"},
					"Purpose"			: {"$ref" : "#/definitions/Profile/Purpose"},
					"Title"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Description"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Version"			: {"$ref" : "#/definitions/Profile/Version"}
				},
				"required"				: ["Type", "Purpose", "Title", "Description", "Version"]
			}
		},

		"Entity" : {
			"Entity" : {
				"type" : "object",
				"properties":{
					"ABN"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"MainName"			: {"$ref" : "#/definitions/Types/NonEmptyString"}
				},
				"required"				: ["ABN", "MainName"]
			}
		},

		"PayrollAdministration" : {
			"Contact" : {
				"type" : "object",
				"properties" : {
					"FamilyName"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"GivenName"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"OtherGivenName"	: {"$ref" : "#/definitions/Types/NonEmptyString"}
				},
				"required"				: ["FamilyName", "GivenName"]
			},

			"Email"						: {"$ref" : "#/definitions/Types/Email"},

			"Telephone" : {
				"type": "object",
				"properties":{
					"ServiceLine"		: {"enum" : ["01", "02"]},
					"AreaCode"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Number"			: {"$ref" : "#/definitions/Types/NonEmptyString"}
				},
				"required"				: ["ServiceLine", "Number"]
			},

			"Account" : {
				"type" : "object",
				"properties" : {
					"BSB"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Number"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"AccountName"		: {"$ref" : "#/definitions/Types/NonEmptyString"}
				},
				"required"				: ["BSB", "Number", "AccountName"]
			},

			"Behaviours" : {
				"type" : "object",
				"properties":{
					"ElectronicErrorMessaging" : {"$ref" : "#/definitions/Types/Boolean"},
					"EmployerIsPayer"	: {"$ref" : "#/definitions/Types/BooleanDefaultTrue"}
				},
				"required"				: ["ElectronicErrorMessaging"]
			},

			"PayrollAdministration" : {
				"type" : "object",
				"properties":{
					"ABN"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"MainName"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Contact"			: {"$ref" : "#/definitions/PayrollAdministration/Contact"},
					"Email"				: {"$ref" : "#/definitions/PayrollAdministration/Email"},
					"Telephone"			: {"$ref" : "#/definitions/PayrollAdministration/Telephone"},
					"Account"			: {"$ref" : "#/definitions/PayrollAdministration/Account"},
					"Behaviours"		: {"$ref" : "#/definitions/PayrollAdministration/Behaviours"}
				},
				"required"				: ["ABN", "MainName", "Contact", "Email", "Telephone", "Account", "Behaviours"]
			}
		},

        "Employees": {
            "Name" : {
                "type" : "object",
                "properties" : {
                    "Title"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "NameSuffix"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "FamilyName"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "GivenName"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "OtherGivenName"	: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["FamilyName", "GivenName"]
            },

            "Address": {
                "type": "object",
                "properties":{
                    "Usage"				: {"enum": ["RES", "POS"]},
                    "Line1"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Line2"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Line3"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Line4"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Locality"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "PostCode"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "StateOrTerritory"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Country"			: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["Usage", "Line1", "Locality", "Country"]
            },
            
            "Telephone" : {
                "type": "object",
                "properties":{
                    "ServiceLine"		: {"enum": ["01", "02"]},
                    "AreaCode"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Number"			: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["ServiceLine", "Number"]
            },

            "Type"						: {"enum": ["Guarantee", "Award", "Personal", "Sacrifice", "Voluntary", "Spouse", "Child", "ThirdParty"]},

            "Types" : {
                "type": "array",
                "items"					: {"$ref" : "#/definitions/Employees/Type"},
                "minItems" : 1
            },

            "OtherDetail": {
                "type": "object",
                "properties": {
                    "Details"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Description"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "StartDate"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "EndDate"			: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["Details", "Description"]
            },

            "OtherDetails" : {
                "type": "array",
                "items"					: {"$ref" : "#/definitions/Employees/OtherDetail"},
                "minItems" : 1
            },

            "Contribution" : {
                "type": "object",
                "properties":{
                    "FundABN"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "USI"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "MemberID"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Type"				: {"$ref" : "#/definitions/Employees/Types"},
                    "TFNNotProvided"	: {"$ref" : "#/definitions/Types/Boolean"},
                    "InsuranceOptOut"	: {"$ref" : "#/definitions/Types/Boolean"},
                    "FundRegistrationDate": {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "BenefitCategory"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "CommencementDate"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "OtherDetails"		: {"$ref" : "#/definitions/Employees/OtherDetails"}
                },
                "required"				: ["Type", "TFNNotProvided"]
            },

			"Contributions" : {
                "type" : "array",
                "items"					: {"$ref" : "#/definitions/Employees/Contribution"},
                "minItems": 1
			},

			"Employee" : {
                "type": "object",
                "properties":{
                    "EmployeeID"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Name"				: {"$ref" : "#/definitions/Employees/Name"},
                    "Sex"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "BirthDate"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Address"			: {"$ref" : "#/definitions/Employees/Address"},
                    "Email"				: {"$ref" : "#/definitions/Types/Email"},
                    "Telephone"			: {"$ref" : "#/definitions/Employees/Telephone"},
                    "TFN"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "EmploymentStartDate": {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "AtWorkIndicator"	: {"$ref" : "#/definitions/Types/Boolean"},
                    "BenefitsSalary"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "ContributionsSalary": {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "ContributionsSalaryEffectiveStartDate": {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "InsuranceSalary"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "WeeklyHoursWorked"	: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Occupation"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "EmploymentStatusCode": {"enum": ["Casual", "Contractor", "Full time", "Part time"]},
                    "Contributions"		: {"$ref" : "#/definitions/Employees/Contributions"}
                },
                "required"				: ["EmployeeID", "Name", "Sex", "BirthDate", "Address", "Email", "Telephone"]
			},


			"Employees" : {
				"type" : "array",
				"items"					: {"$ref" : "#/definitions/Employees/Employee"},
				"minItems": 1
			}
		},

		"ClearingHouses" : {
            "Account" : {
                "type" : "object",
                "properties" : {
                    "BSB"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Number"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "AccountName"		: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["BSB", "Number", "AccountName"]
            },

            "Payment" : {
                "type" : "object",
                "properties" : {
                    "Method"			: {"enum": ["DirectCredit", "DirectDebit", "Bpay"]},
                    "BPAYReference"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "BPAYBiller"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Account"			: {"$ref" : "#/definitions/ClearingHouses/Account"}
                },
                "required"				: ["Method"]
            },

			"ClearingHouse" : {
				"type" : "object",
				"properties" : {
					"MainName"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"ABN"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Payment"			: {"$ref" : "#/definitions/ClearingHouses/Payment"}
				},
				"required"				: ["MainName", "ABN", "Payment"]
            },

            "ClearingHouses" : {
				"type" : "array",
				"items"					: {"$ref" : "#/definitions/ClearingHouses/ClearingHouse"},
				"minItems": 1
            }
        },

		"SuperannuationProducts" : {
            "Account" : {
                "type" : "object",
                "properties" : {
                    "BSB"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "Number"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "AccountName"		: {"$ref" : "#/definitions/Types/NonEmptyString"}
                },
                "required"				: ["BSB", "Number", "AccountName"]
            },

            "Payment" : {
                "type" : "object",
                "properties" : {
                    "Method"			: {"enum": ["DirectCredit", "DirectDebit", "Bpay"]},
                    "BPAYReference"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
                    "BPAYBiller"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Account"			: {"$ref" : "#/definitions/SuperannuationProducts/Account"}
                },
                "required"				: ["Method"]
            },

			"RegistrationMandatoryOverrides" : {
				"type" : "array",
				"items"					: {"$ref" : "#/definitions/Types/NonEmptyString"},
				"minItems" : 1
			},

			"RegistrationMandatoryOtherDetail": {
				"type" : "object",
				"properties" : {
					"Name"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Startdate"			: {"$ref" : "#/definitions/Types/BooleanDefaultFalse"},
					"Enddate"			: {"$ref" : "#/definitions/Types/BooleanDefaultFalse"}
				},
				"required"				: ["Name"]
			},

			"RegistrationMandatoryOtherDetails" : {
				"type": "array",
				"items"					: {"$ref" : "#/definitions/SuperannuationProducts/RegistrationMandatoryOtherDetail"},
				"minItems" : 1
			},

			"ContributionMandatoryOtherAmounts" : {
				"type" : "array",
				"items"					: {"$ref" : "#/definitions/Types/NonEmptyString"},
				"minItems" : 1
			},

            "ContributionMandatoryOtherDetails" : {
				"type": "array",
				"items"					: {"$ref" : "#/definitions/Types/NonEmptyString"},
				"minItems" : 1
			},

			"Behaviours" : {
				"type" : "object",
				"properties":{
					"RegistrationMandatoryOverrides"	: {"$ref" : "#/definitions/SuperannuationProducts/RegistrationMandatoryOverrides"},
					"RegistrationMandatoryOtherDetails"	: {"$ref" : "#/definitions/SuperannuationProducts/RegistrationMandatoryOtherDetails"},
					"ContributionMandatoryOtherAmounts"	: {"$ref" : "#/definitions/SuperannuationProducts/ContributionMandatoryOtherAmounts"},
					"ContributionMandatoryOtherDetails"	: {"$ref" : "#/definitions/SuperannuationProducts/ContributionMandatoryOtherDetails"}
				}
			},
			
			"SuperannuationProduct" : {
				"type" : "object",
				"properties" : {
					"FundName"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"FundABN"			: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"ProductName"		: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"USI"				: {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Default"			: {"$ref" : "#/definitions/Types/BooleanDefaultFalse"},
                    "FundGeneratedEmployerIdentifier" : {"$ref" : "#/definitions/Types/NonEmptyString"},
					"Payment"			: {"$ref" : "#/definitions/SuperannuationProducts/Payment"},
					"Behaviours"		: {"$ref" : "#/definitions/SuperannuationProducts/Behaviours"}
				},
				"required"				: ["FundName", "FundABN"]
            },

            "SuperannuationProducts" : {
				"type" : "array",
				"items"					: {"$ref" : "#/definitions/SuperannuationProducts/SuperannuationProduct"},
				"minItems": 1
            }
        }
	}
}