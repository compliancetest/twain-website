{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "SMSF",
    "Version": {
        "Major" : 2,
        "Minor" : 0
    },
    "type": "object",
    "properties": {
        "Profile" : {
            "type" : "object", 
            "properties":{
                "Type": { "enum": ["SMSF"]},
                "Purpose": {
                    "enum": ["Positive", "Negative"],
                    "default" : "Positive" 
                },
                "Title": { "type": "string"},            
                "Description": { "type": "string"},
                "Version": {
                    "type": "object",
                    "properties": {
                        "Major" : { 
                            "type" : "integer",
                            "minimum" : 0
                        },
                        "Minor" : { 
                            "type" : "integer",
                            "minimum" : 0
                        },
                           "Patch" : { 
                            "type" : "integer",
                            "minimum" : 0
                        }
                    },
                    "required" : ["Major", "Minor"]
                }
            },
            "required" : ["Type", "Purpose", "Title", "Description", "Version"]           
        },

        "Entity" : {
            "type" : "object", 
            "properties":{
                "ABN": { "type": "string"},
                "MainName": { "type": "string"}
            },            
            "required" : ["ABN", "MainName"]            
        },

        "Fund" : {
            "type" : "object", 
            "properties":{
                "ABN": { "type": "string"},
                "MainName": { "type": "string"}
            },            
            "required" : ["ABN", "MainName"]
        },

        "FundAdministration" : {
            "type" : "object", 
            "properties":{
                "ABN": { "type": "string"},
                "MainName": { "type": "string"},
                "Contact" : {
                    "type" : "object",
                    "properties" : {
                        "FamilyName": {"type": "string"},
                        "GivenName": {"type": "string"},
                        "OtherGivenName": {"type": "string"}
                    },
                    "required" : ["FamilyName", "GivenName"]
                },
                "Email" :{ 
                    "type": "string",
                      "format" : "email" 
                },
                "Telephone" : {
                    "type": "object",
                    "properties":{
                        "ServiceLine" : {
                             "enum": ["01", "02"]
                        },
                        "AreaCode" : {"type": "string"},
                        "Number" : {"type": "string"}
                    },
                    "required" : ["ServiceLine", "Number"]
                },
                "Account" : {
                       "properties":{
                        "BSB": { "type": "string"},
                        "Number": { "type": "string"},
                        "AccountName": { "type": "string"}
                    },
                    "required" : ["BSB", "Number", "AccountName"]          
                },
                "Behaviours" : {
                    "type" : "object", 
                    "properties":{
                        "ErrorReporting" : {
                            "enum": ["Partial", "Progressive"],
                            "default": "Partial" 
                        }
                    },             
                    "required" : ["ErrorReporting"]
                }

            },    
            "required" : ["ABN", "MainName", "Contact", "Email", "Telephone", "Account", "Behaviours"]
        },

        "Members": {
            "type": "array",
            "items": {
                "type": "object",
                "properties":{
                    "MemberID" : {"type": "string"},    
                    "Name" : {
                        "type" : "object",
                        "properties" : {
                            "Title" : {"type": "string"},
                            "NameSuffix": {"type": "string"},
                            "FamilyName": {"type": "string"},
                            "GivenName": {"type": "string"},
                            "OtherGivenName": {"type": "string"}
                        },
                        "required" : ["FamilyName", "GivenName"]
                    },
                    "Sex": {"type": "string"},
                    "Birthdate": {"type": "string"},
                    "Address": {
                        "type": "object",
                        "properties":{
                            "Usage": {
                                "enum": ["RES", "POS"]
                            },
                            "Line1" : {"type": "string"},
                            "Line2" : {"type": "string"},
                            "Line3" : {"type": "string"},
                            "Line4" : {"type": "string"},
                            "Locality": {"type": "string"},
                            "PostCode": {"type": "string"},
                            "StateOrTerritory": {"type": "string"},
                            "Country": {"type": "string"}
                        },
                        "required" : ["Usage", "Line1", "Locality", "Country"]
                    },
                    "Email" :{ 
                        "type": "string",
                        "format": "email" 
                    },
                    "Telephone" : {
                        "type": "object",
                        "properties":{
                            "ServiceLine" : {
                                "enum": ["01", "02"]
                            },
                            "AreaCode" : {"type": "string"},
                            "Number" : {"type": "string"}
                        },
                        "required" : ["ServiceLine", "Number"]
                    },
                    "TFN" : {"type": "string"},
                    "TFNNotProvided" : {
                        "type": "boolean",
                        "default": "false" 
                    }
                },
                "required" : ["MemberID", "Name", "Sex", "Birthdate", "Address", "Email", "Telephone"]
            },
            "minItems" : 1
        },

        "Behaviours" : {
            "type" : "object", 
            "properties":{
                "RegistrationMandatoryOverrides" : {
                    "type": "array",
                    "items": {"type" : "string"},
                    "minItems" : 1    
                },    
                "RegistrationMandatoryOtherDetails" : {
                    "type": "array",
                    "items": {
                        "type" : "object",
                        "properties" : {
                            "Name" : {"type" : "string"},
                            "Startdate" : {
                                "type": "boolean",
                                "default": false                                
                            },
                            "Enddate" : {
                                "type": "boolean",
                                "default": false                                
                            }
                        },
                        "required" : ["Name"]
                    },
                    "minItems" : 1    
                },    
                "ContributionMandatoryOtherAmounts" : {
                    "type": "array",
                    "items": {"type" : "string"},
                    "minItems" : 1    
                },    

                "ContributionMandatoryOtherDetails" : {
                    "type": "array",
                    "items": {"type" : "string"},
                    "minItems" : 1    
                }
             }             
        }
    },

    "required": ["Profile", "Entity", "Fund", "FundAdministration", "Members"]    
}
