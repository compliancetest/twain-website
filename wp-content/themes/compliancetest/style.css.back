.lighter_gray_bcg{
	background: #fbfbfb;
	box-shadow: inset 0px 0px 20px #f0f0f0;
	-webkit-box-shadow: inset 0px 0px 20px #f0f0f0;
	-moz-box-shadow: inset 0px 0px 20px #f0f0f0;
	-o-box-shadow: inset 0px 0px 20px #f0f0f0; 
}

.tabs li {
	float: left;
	border-radius: 6px 6px 0 0;
	-moz-border-radius: 6px 6px 0 0;
	-webkit-border-radius: 6px 6px 0 0;
	-o-border-radius: 6px 6px 0 0;
	background: #ffffff; /* Old browsers */
	/* IE9 SVG, needs conditional override of 'filter' to 'none'
	background: url(data:image/svg+xml;base64,); */
	background: -moz-linear-gradient(top,  #ffffff 2%, #eaeaea 100%); /* FF3.6+ */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(2%,#ffffff), color-stop(100%,#eaeaea)); /* Chrome,Safari4+ */
	background: -webkit-linear-gradient(top,  #ffffff 2%,#eaeaea 100%); /* Chrome10+,Safari5.1+ */
	background: -o-linear-gradient(top,  #ffffff 2%,#eaeaea 100%); /* Opera 11.10+ */
	background: -ms-linear-gradient(top,  #ffffff 2%,#eaeaea 100%); /* IE10+ */
	background: linear-gradient(to bottom,  #ffffff 2%,#eaeaea 100%); /* W3C */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#ffffff', endColorstr='#eaeaea',GradientType=0 ); /* IE6-8 */
	margin: 0 10px 0 0;
	box-shadow: 0 0 20px -10px #fff inset;
	border: 1px solid #e1e1e1;
	margin-top: 4px;
}

	.tabs li:hover {
		background: #fff;
	}
	
	.tabs li.active {
		background: #2d85cf;
		box-shadow: 0 0 30px -7px #002747 inset;
		-moz-box-shadow: 0 0 30px -7px #002747 inset;
		-webkit-box-shadow: 0 0 30px -7px #002747 inset;
		-o-box-shadow: 0 0 30px -7px #002747 inset;
		padding: 2px;
		border: 1px solid #3577ad;
		margin-top: 0px;
	}

	.tabs li a {
		padding: 5px;
		display: block;
		font-family: 'Open Sans', Arial, sans-serif;
		color: #666;
		text-shadow: 0 1px 0 #fff;
		-moz-text-shadow: 0 1px 0 #fff;
		-webkit-text-shadow: 0 1px 0 #fff;
		-o-text-shadow: 0 1px 0 #fff;
		font-size: 16px;
		font-weight: normal;
	}
	
		.tabs li a span {
			display: block;
		}
		
		.tabs li a span.text {
			line-height: 28px;
			padding: 0 15px;
			background: url(images/tab_separator.png) left center no-repeat;
		}
			.tabs li.active a span.text {
				color: #fff;
				text-shadow: 0 1px 0 #002747;
				-moz-text-shadow: 0 1px 0 #002747;
				-webkit-text-shadow: 0 1px 0 #002747;
				-o-text-shadow: 0 1px 0 #002747;
			}
		
			.tabs li a .icon {
				width: 27px;
				height: 27px;
			}
			
			.tabs li a  #icon_test_suites {
				background: url(images/test_suits_tab_icon.png) 6px -25px no-repeat;
			}
			
				.tabs li.active a  #icon_test_suites {
					background: url(images/test_suits_tab_icon.png) 6px 1px no-repeat;
				}
			
			.tabs li a  #icon_wiki {
				background: url(images/wiki_tab_icon.png) 1px 3px no-repeat;
			}
			
			.tabs li a  #icon_forum {
				background: url(images/forum_tab_icon.png) 0px 5px no-repeat;
			}
			
			.tabs li a  #icon_downloads {
				background: url(images/downloads_tab_icon.png) 2px 5px no-repeat;
			}

	.tabs li.active {
		background: #2b87d6;
	}

.tabs_wrap {
	border: 1px solid #e1e1e1;
	padding: 10px;
}

.tab-content {
	display: none;
	box-shadow: 0 0 3px #999;
	-moz-box-shadow: 0 0 3px #999;
	-webkit-box-shadow: 0 0 3px #999;
	-o-box-shadow: 0 0 3px #999;
}


.tab-content:first-child {
	display: block;
}

.tabs_sv li {
	float: left;
	margin-top: 4px;
}

