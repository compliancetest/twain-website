	background: -webkit-gradient(linear, left top, left bottom, from(#237fcf), to(#285d89)); /* for webkit browsers */
	background: -moz-linear-gradient(top,  #237fcf,  #285d89); /* for firefox 3.6+ */
	height: 61px;
	margin-top: -12px;
	position: relative;
	color: #fff;
	padding: 16px 5px 0;
	text-align: center;
	box-shadow: 0 1px 1px rgba(255, 255, 255, .5) inset;
