#three_boxes_sv a{
	display: block;
	background: #ce2d25; /* for non-css3 browsers */
	filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#ce2d25', endColorstr='#801514'); /* for IE */
	background: -webkit-gradient(linear, left top, left bottom, from(#ce2d25), to(#801514)); /* for webkit browsers */
	background: -moz-linear-gradient(top,  #ce2d25,  #801514); /* for firefox 3.6+ */
	width: 255px;
	border-radius: 7px;
	padding: 7px 5px;
	border: 1px solid #7b1413;
	height: 37px;
	margin: 12px auto;
	float: right;
	cursor: pointer;
}

