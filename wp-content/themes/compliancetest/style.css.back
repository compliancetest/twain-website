/* ********* TYPOGRAPHY ******************* */

* {
	text-shadow: none;
}

h1,h2,h3,h4,h5,h6 {
	font-family: 'Open Sans', Arial, sans-serif;
	color: #1f5aa4;
	text-shadow: none;
	font-weight: normal;
}

h1 {

}

h2 {

}

h3 {
	font-weight: bold;
	font-size: 20px;
}

h4 {

}

h5 {
	font-size: 14px;
	font-weight: bold;
}

h6 {

}

p {

}

ul, ol {

}

ul {

}

ol {

}

dl {

}

dt {

}

dd {

}

strong {

}

cite, em, i {

}

blockquote {

}

blockquote em, blockquote i, blockquote cite {

}

blockquote cite {

}

pre {

}

code, kbd {

}

abbr, acronym, dfn {

}

address {

}

ins {

}

sup,
sub {

}

sup {

}

sub {

}

input[type="button"], input[type="button"]:hover, 
input[type="search_button"], input[type="search_button"]:hover, 
input[type="submit"], input[type="submit"]:hover {
padding: 10px;
color: white;
font-family: 'Open Sans', Arial, sans-serif;
font-weight: 700;
}

.padding0-10{
	padding: 0px 10px !important;
}

.padding15-20{
	padding: 15px 20px !important;
}

/* ************** Links ************** */
a:link {
	color: #2c80e8;
	text-shadow: none;
}

a:focus,
a:active,
a:hover {
	color: #2C6DBD;
}

/********* FORMS *******************/

input[type=text],
input[type=password],
textarea {

}
input[type=text]:focus,
textarea:focus {

}
textarea {

}
input[type=text] {

}
input#s {

}

input#searchsubmit {

}

/* ************** GRID ELEMENTS ***************** */

.column {
	padding: 20px;
	margin-bottom: 0;
	font-family: 'Open sans';
}

/* **************** GRID ELEMENTS *********************** */	

.default_grid {}

.default_grid .grid_head {
	border: 1px solid #1d76c0;
	border-radius: 3px 3px 0 0;
	-moz-border-radius: 3px 3px 0 0;
	-webkit-border-radius: 3px 3px 0 0;
	-o-border-radius: 3px 3px 0 0;
}

.blue_grid {
	background: #2c80e8;
	border:1px solid #1d63bb;
	color: white;
	padding-top: 3px !important;
}

.single_line{
	margin-top:8px;
}

			.default_grid .grid_head .sortable {
				box-shadow: 0 10px 30px rgba(0,0,0,0.2), 0 10px 30px -10px rgba(0,0,0,0.4) inset , 0 -10px 30px -10px rgba(255,255,255,0.2) inset, 0 0 3px rgba(0,0,0,0.3) inset;
				-moz-box-shadow: 0 10px 30px rgba(0,0,0,0.2), 0 10px 30px -10px rgba(0,0,0,0.4) inset , 0 -10px 30px -10px rgba(255,255,255,0.2) inset, 0 0 3px rgba(0,0,0,0.3) inset;
				-webkit-box-shadow: 0 10px 30px rgba(0,0,0,0.2), 0 10px 30px -10px rgba(0,0,0,0.4) inset , 0 -10px 30px -10px rgba(255,255,255,0.2) inset, 0 0 3px rgba(0,0,0,0.3) inset;
				-o-box-shadow: 0 10px 30px rgba(0,0,0,0.2), 0 10px 30px -10px rgba(0,0,0,0.4) inset , 0 -10px 30px -10px rgba(255,255,255,0.2) inset, 0 0 3px rgba(0,0,0,0.3) inset;
			}

	.default_grid .red_head {
		background: url(images/red_dotted_bcg.png) !important;
		box-shadow: 0 0px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.1) inset;
		-moz-box-shadow: 0 0px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.1) inset;
		-webkit-box-shadow: 0 0px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.1) inset;
		-o-box-shadow: 0 0px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.1) inset;
		border-bottom: 1px solid #e33f3f;
	}
	
	.default_grid .blue_head {
		background: url(images/blue_dotted_bcg.png) !important;
		box-shadow: 0 1px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.3) inset;
		-moz-box-shadow: 0 1px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.3) inset;
		-webkit-box-shadow: 0 1px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.3) inset;
		-o-box-shadow: 0 1px 2px rgba(255,255,255,0.4) inset, 0 -10px 20px rgba(255,255,255,0.3) inset;
	}
	
		.default_grid .blue_head .grid_cell, .default_grid .red_head .grid_cell {
			background-color: none;
		}
		
		.default_grid .red_head .grid_cell {
			color: #fff;
			font-weight: bold;
			text-shadow: 0px 1px 0px #A52A2A !important;
			-moz-text-shadow: 0px 1px 0px #A52A2A  !important;
			-webkit-text-shadow: 0px 1px 0px #A52A2A !important;
			-o-text-shadow: 0px 1px 0px #A52A2A !important;
			background: none;
		}
		
			
		

.default_grid .grid_head .grid_cell, .default_grid .grid_head .grid_cell h5 {
	color: #fff !important;
	text-shadow: 0 1px 0 #155386;
	-webkit-text-shadow: 0 1px 0 #155386;
	-moz-text-shadow: 0 1px 0 #155386;
	-o-text-shadow: 0 1px 0 #155386;
	font-weight: normal;
}

.default_grid .grid_head .grid_cell h5 {
	margin: 0;
	font-weight: bold;
}

.default_grid .grid_body {
	border: 1px solid #b7b7b7;
	border-top: 0;
	overflow: visible;
}
.default_grid .grid_row {
	padding: 4px;
}

.default_grid .grid_body .grid_row {
	background: #fcfbfc; /* Old browsers */
	/* IE9 SVG, needs conditional override of 'filter' to 'none'
	background: url(data:image/svg+xml;base64,); */
	background: -moz-linear-gradient(top,  #fcfbfc 1%, #f2f3f2 100%); /* FF3.6+ */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(1%,#fcfbfc), color-stop(100%,#f2f3f2)); /* Chrome,Safari4+ */
	background: -webkit-linear-gradient(top,  #fcfbfc 1%,#f2f3f2 100%); /* Chrome10+,Safari5.1+ */
	background: -o-linear-gradient(top,  #fcfbfc 1%,#f2f3f2 100%); /* Opera 11.10+ */
	background: -ms-linear-gradient(top,  #fcfbfc 1%,#f2f3f2 100%); /* IE10+ */
	background: linear-gradient(to bottom,  #fcfbfc 1%,#f2f3f2 100%); /* W3C */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#fcfbfc', endColorstr='#f2f3f2',GradientType=0 ); /* IE6-8 */

}

.default_grid .grid_cell {
	padding: 5px;
	text-shadow: 0 1px 0 #fff;
	-moz-text-shadow: 0 1px 0 #fff;
	-webkit-text-shadow: 0 1px 0 #fff;
	-o-text-shadow: 0 1px 0 #fff;
}

	.default_grid .grid_cell_fitted {
		padding: 9px !important;
		border-left: 1px solid rgba(0,0,0,0.1);
		border-right: 1px solid rgba(255,255,255,0.1);
		background-image: url(images/gray_noise_bcg.png);
	}
	
	
		.default_grid .grid_cell_fitted:first-child {
			border-left: 0;
		}
		
		.default_grid .grid_cell_fitted:last-child {
			border-right: 0;
		}

.default_grid .grid_button {
	background: rgba(0,0,0,0.1);
	padding: 8px;
	text-align: center;
	height: 32px;
	width: 32px;
}

.default_grid .grid_button_right {
	float: right !important;
	border-left: 1px solid rgba(0,0,0,0.2);
	margin: -4px -4px -6px 4px;
}

.default_grid .grid_button_left {
	float: left !important;
	border-right: 1px solid rgba(0,0,0,0.2);
		margin: -4px 4px -6px -4px;
}

.default_grid .grid_button:hover .simple_tooltip {
	display: block;
	font-weight: normal !important;
}

.default_grid .expandable {
	background-image: url(images/grid_expandable_c.png);
	background-position: center center;
	background-repeat: no-repeat;
	cursor: pointer;
}

	.default_grid .open {
		background-image: url(images/grid_expandable_o.png);
	}

.default_grid  .expandable_content {
	display: none;
}

.default_grid .grid_action {
	background: #7cbdf4; /* Old browsers */
	/* IE9 SVG, needs conditional override of 'filter' to 'none' */
	background: url(data:image/svg+xml;base64,);
	background: -moz-linear-gradient(top,  #7cbdf4 1%, #2690ea 4%, #3577ad 100%); /* FF3.6+ */
	background: -webkit-gradient(linear, left top, left bottom, color-stop(1%,#7cbdf4), color-stop(4%,#2690ea), color-stop(100%,#3577ad)); /* Chrome,Safari4+ */
	background: -webkit-linear-gradient(top,  #7cbdf4 1%,#2690ea 4%,#3577ad 100%); /* Chrome10+,Safari5.1+ */
	background: -o-linear-gradient(top,  #7cbdf4 1%,#2690ea 4%,#3577ad 100%); /* Opera 11.10+ */
	background: -ms-linear-gradient(top,  #7cbdf4 1%,#2690ea 4%,#3577ad 100%); /* IE10+ */
	background: linear-gradient(to bottom,  #7cbdf4 1%,#2690ea 4%,#3577ad 100%); /* W3C */
	filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#7cbdf4', endColorstr='#3577ad',GradientType=0 ); /* IE6-8 */
	border: 1px solid #3577ad;
	padding: 3px;
	text-align: center;
	display: block;
	width: 16px;
	height: 16px;
	margin: -5px 0;
}

	.default_grid .grid_action img {
		max-width: 100%;
		max-height: 100%;
		margin: 0 auto;
	}
	
.default_grid .grid_body .grid_row:nth-child(odd) .grid_cell_fitted { 

}

.default_grid .grid_body .grid_row:nth-child(even) .grid_cell_fitted {
	background-image: url(images/gray_noise_bcg_o.png);
 }
 
.default_grid .grid_body .grid_row:last-child .grid_cell_fitted {
	border-bottom: 0;
 }
 
 .default_grid .grid_head .grid_row .grid_cell_fitted { 
	
}

.default_grid .grid_head .grid_row:nth-child(odd) .grid_cell_fitted { 
	background: none;
}

.default_grid .grid_head .grid_row:nth-child(even) .grid_cell_fitted {
	background-image: none;
 }
 
.default_grid .grid_head .grid_row:last-child .grid_cell_fitted {
	border-right: 0;
 }
 
 .default_grid .button {
	margin: -5px 0;
 }

/*EXTRA GRID*/

.shadowwhite {
	text-shadow: 0px -1px 1px white;
}

.shadowblue {
	text-shadow: 0px -1px 1px #164176;
}

.grid {
	
}

.grid_head .grid_cell {
	font-weight: bold;
	font-size: 13px;
}

.grid_body {
	border: 2px #d8d8d8 solid;
	overflow: hidden;
}

.grid_body .grid_cell {
	font-size: 12px;
	font-size: normal;
}

.grid_row {
	clear: both;
	padding: 10px;
	border-bottom: 1px solid #c8c8c8
}

	.grid_row:nth-child(odd) { 

	}
	
	.grid_row:nth-child(even) {
		background-color: rgba(0, 0, 0, 0.02);
	 }
	 
	 .grid_row:last-child {
		border-bottom: 0;
	 }
	 
.grid_cell {
	display: inline;
	width: auto;
	float: left;padding: 5px 0;
	box-sizing:border-box;
	-moz-box-sizing:border-box; 
	-webkit-box-sizing:border-box;
	-o-box-sizing:border-box;
	line-height: 14px;
}

.last_grid_cell{
	border-bottom: 0px;
}

	.grid_cell a {
		text-decoration: underline;
	}



/* ************** STRUCTURAL ELEMENTS ***************** */

#wrapper {
	width: 100%;
	background: white;
	font-family: Arial;
}

#menu-wrapper {
	width: 100%;
	margin-bottom: 0px;
	background: url(images/menu_wrapper.jpg) top center repeat-x;
	height: 39px;
	border-top: 1px solid white; 
	border-bottom: 1px solid white; 
}
#main_menu {
	width: 75%;
	padding: 0;
	margin: 0 auto;
}

#header-wrapper {
	width: 100%;
	margin-bottom: 0px;
	background: url(images/header_wrapper.jpg) top center repeat-x;
	height: 80px;
}

	.header {
		width: 1000px;
		padding: 0;
		margin: 0 auto;
	}
	

#content-pattern {
	width: 100%;
	margin-bottom: 0px;
	background: url(images/pattern.png) top center repeat;
}

	#content-wrapper {
		width: 100%;
		margin-bottom: 0px;
		background: url(images/content.png) top center repeat-x;
	}

	.content {
		width: 1000px;
		padding: 0;
		margin: 0 auto;
	}
	
	.container {
		background: #fff;
		box-shadow: 0 0 5px #999;
		-moz-box-shadow: 0 0 5px #999;
		-webkit-box-shadow: 0 0 5px #999;
		-o-box-shadow: 0 0 5px #999;
	}
	
#footer-wrapper {
	width: 100%;
	margin-bottom: 0px;
	background: url(images/footer.png) top center repeat;
	border-top: 1px solid #D8D8D8;
}

	.footer {
		width: 1000px;
		padding: 0;
		margin: 0 auto;
	}
	
.sidebar {
	width: 200px;
	float: left;
}

/* **************** HEADER ELEMENTS *********************** */

.logo {
	padding-top: 15px;
}

#cssmenu ul {

}

#cssmenu ul a {
	display: block;
	line-height: 39px;
	padding-right: 20px;
}


#cssmenu a:link, #cssmenu a:visited {
	color: #fff;
	text-decoration: none;
	font-weight: 400;
	font-family: 'Open Sans', Arial, sans-serif;
	font-size: 13px;
	text-shadow: 0px 1px 0px #20436b;
	padding-left: 20px;

}

#cssmenu a:hover, #cssmenu a:active {
	color: #fff;
	text-shadow: none;
	box-shadow: 0 0 10px #133d68 inset !important;
	-webkit-box-shadow: 0 0 10px #133d68 inset !important;
	-moz-box-shadow: 0 0 10px #133d68 inset !important;
	background: rgba(0,0,0,0.1);
	z-index: 1;	
}

#cssmenu{ height:37px; display:block; padding:0; margin: 0;  border:1px solid; border-radius:5px; } 
#cssmenu > ul {list-style:inside none; padding:0; margin:0;} 
#cssmenu > ul > li {float: left;
background: url(images/menu_separator.png) center left no-repeat;
z-index: 100;} 
#cssmenu > ul > li > a{color: #fff;
text-decoration: none;
font-weight: 400;
font-family: 'Open Sans', Arial, sans-serif;
font-size: 13px;
text-shadow: 0px 1px 0px #20436b;
padding-left: 20px; } 
#cssmenu > ul > li:first-child > a{border-radius:5px 0 0 5px;} 
#cssmenu > ul > li > a:after{ content:''; position:absolute; border-right:1px solid; top:-1px; bottom:-1px; right:-2px; z-index:99; } 
#cssmenu ul li.has-sub:hover > a:after{top:0; bottom:0;} 
/*
#cssmenu > ul > li.has-sub > a:before{ content:''; position:absolute; top:18px; right:6px; border:5px solid transparent; border-top:5px solid #fff; } 
*/
#cssmenu > ul > li.has-sub:hover > a:before{top:19px;} 
#cssmenu ul li.has-sub:hover > a{color: #fff;
text-decoration: none;
font-weight: 400;
font-family: 'Open Sans', Arial, sans-serif;
font-size: 13px;
text-shadow: 0px 1px 0px #20436b;
padding-left: 20px;}
 
#cssmenu ul li.has-sub:hover > ul, #cssmenu ul li.has-sub:hover > div{display:block;} 

#cssmenu ul li.has-sub > a:hover{
	border-radius: 0px;
	color: #fff;
	text-decoration: none;
	font-weight: 400;
	font-family: 'Open Sans', Arial, sans-serif;
	font-size: 13px;
	text-shadow: 0px 1px 0px #20436b;
	padding-left: 20px;
} 
#cssmenu ul li > ul, #cssmenu ul li > div{ display:none; width:auto; position:absolute; top:38px; padding:10px 0; background:#3f3f3f; border-radius:0 0 5px 5px; z-index:999; } 
#cssmenu ul li > ul{
	padding-top: 25px;
	width: 1000px;
	background: #fff url(images/menu_shadow.jpg) top center repeat-x;
	border-radius: 0px;
	margin-top: 1px;
	z-index: 2;
} 
#cssmenu ul li > ul li{margin-left: 40px !important; display:block; list-style:inside none; padding:0; margin:0; position:relative;} 
#cssmenu ul li h4 > ul li a{ margin-left: 33px; outline:none; display:block; position:relative; margin:0; padding:8px 20px; font:10pt Arial, Helvetica, sans-serif; color:#fff; text-decoration:none; text-shadow:1px 1px 0 rgba(0,0,0, 0.5); } 


#cssmenu, #cssmenu > ul > li > ul > li a:hover{} 
#cssmenu{
	width: 1000px;
	padding: 0;
	margin: 0 auto;
	position: relative;
	border: none;

} 

#cssmenu p {
	margin-left: 30px;
	font-size: 12px;
	color: #2f3030;
	text-shadow: none;
	margin-bottom: 10px;
}

#cssmenu img {
	padding-right: 10px;
}

#cssmenu h3 {
	font-family: 'Oswald', Arial, sans-serif;
	color: #2f3030;
	text-shadow: none;
	font-size: 20px;
	font-weight: 400;
}

#cssmenu > ul > li > a{color:#fff;} 
#cssmenu > ul > li > a:after{display:none;} 
#cssmenu > ul > li > a:hover{}

#cssmenu input[type="button"] {
	background: #316c9c url(images/arrow_button_blue.jpg) center right no-repeat;
	float: right;
	border-radius: 0px;
	box-shadow: none;
	text-shadow: none;
	border: none;
	height: 35px;
	font-family: 'Oswald', Arial, sans-serif;
	padding: 1px 30px 1px 30px;
	font-weight: 400;
	font-size: 17px;
	margin-bottom: 15px;
	margin-top: 15px;
}

#cssmenu h4 {

}

#cssmenu p a {
	background: #316c9c url(images/arrow_button_blue.jpg) center right no-repeat;
	float: left;
	border-radius: 0px;
	box-shadow: none;
	text-shadow: none;
	border: none;
	height: 16px;
	font-family: 'Oswald', Arial, sans-serif;
	padding: 3px 25px 1px 16px;
	font-weight: 400;
	font-size: 12px;
	margin-bottom: 15px;
	margin-top: 0px;
	color: white;
	width: 56px;
	line-height: 14px;
	margin-left: 0px !important;
}


#cssmenu .read_more {
	padding-left: 5px !important;
	width: 70px;
}

/* **************** HOME PAGE ELEMENTS *********************** */
#search_bar {
        width: 791px;
        margin: 0 auto;
}

#search_bar input[type="submit"] {
	float: right;
	background: url(images/red_singup.jpg) top center repeat-x;
	border-radius: 0px 6px 6px 0px;
	border: 1px solid #7b1413;
	box-shadow: inset 0px 2px 1px -1px #e1827d;
	text-shadow: 0px -1px 0px #1d5c91;
    -moz-text-shadow: 0px -1px 0px #7b1413;
    -webkit-text-shadow: 0px -1px 0px #7b1413;
    -o-text-shadow: 0px -1px 0px #7b1413;
    width: 110px !important;
    margin: 0px;
    height: 52px;
    margin-top: -1px;
    font-size: 22px;
    color: #fff;
}

#search_bar input[type="submit"]:hover {
	border-radius: 0px 6px 6px 0px;
		background-image: url(images/white_gloss.png);
		text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
		-moz-text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
		-webkit-text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
		-o-text-shadow: 0 1px 1px rgba(0, 0, 0, .2);
		background-color: #cc2e26;
		text-shadow: 0px -1px 0px #1d5c91;
		-moz-text-shadow: 0px -1px 0px #7b1413;
		-webkit-text-shadow: 0px -1px 0px #7b1413;
		-o-text-shadow: 0px -1px 0px #7b1413;
		width: 110px !important;
		margin: 0px;
		height: 52px;
		margin-top: -1px;
		font-size: 22px;
}

#search_bar input[type="text"] {
	font-size: 21px;
	color: #c9c9c9;
	font-style: italic;
	font-family: 'Open Sans', Arial, sans-serif;
	font-weight: 400;
	border-radius: 6px 0px 0px 6px;
	border:none;
	height: 51px;
	width: 516px;
	box-shadow: none;
	background: #fff url(images/search_icon.jpg) center left no-repeat;
	padding-left: 80px;
     float:left;
}

#search-wrapper {
	background: #396495;
	width: 805px;
	margin: 0 auto;
	border-radius: 10px;
	box-shadow: inset 0px 2px 1px -1px #7dbdf4;
	border: 1px solid #436d9d;
}

#select-wrapper {
	width: 150px;
	float: left;
	background: white;
	height: 51px;
	padding-right: 15px;
}

#select-wrapper select{
	border: 1px solid #c4c4c4;
	border-radius: 3px;
	-webkit-border-radius: 3px;
	-moz-border-radius: 3px;
	-o-border-radius: 3px;
	background: #f8f8f8; /* for non-css3 browsers */
	filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#f9f9f9', endColorstr='#f1f1f1'); /* for IE */
	background: -webkit-gradient(linear, left top, left bottom, from(#f9f9f9), to(#f1f1f1)); /* for webkit browsers */
	background: -moz-linear-gradient(top,  #f9f9f9,  #f1f1f1); /* for firefox 3.6+ */
	color: #7a7a7a;
	padding: 6px 10px;
	margin-top: 10px;
	text-shadow: 0px 1px 1px white;
	
}

#register {
	width: 805px;
	margin: 0 auto;
}

