<script type="application/javascript">
    jQuery(document).ready(function(){
        var isShown = false;
        jQuery(".show_profile").off("click").cplightbox({
            'onClose': function () {
                setTimeout("jQuery('#trigger-schedule-link').click();", 200);
                isShown = true;
            },
            'removeBoxAfterClose': true,
            'onLoad' : function(){
                isShown = false;
            }
        });
        jQuery('.delete_run_action').cplightbox({
            'onClose': function () {
                setTimeout("jQuery('#trigger-schedule-link').click();", 200);
            },
            'removeBoxAfterClose': true,
            type: 'ajax',
            onStart: function(){
                jQuery('#delete-run-box .process-btn').off('click').on('click', function(){
                    jQuery('#delete-run-box .close_btn').click();
                    changeStatus(jQuery('#delete-status').val(), jQuery('#delete-prevstatus').val(), jQuery('#delete-runid').val());
                 });
            }
        });

        jQuery('.terminate_run_action').cplightbox({
            'onClose': function () {
                setTimeout("jQuery('#trigger-schedule-link').click();", 200);
            },
            'removeBoxAfterClose': true,
            type: 'ajax',
            onStart: function(){
                jQuery('#terminate-run-box .process-btn').off('click').on('click', function(){
                    jQuery('#terminate-run-box .close_btn').click();
                    changeStatus(jQuery('#delete-status').val(), jQuery('#delete-prevstatus').val(), jQuery('#delete-runid').val());
                });
            }
        });

        jQuery(".trigger_row").off("click").cplightbox({
            'removeBoxAfterClose': true,
            'onClose': function () {
                setTimeout("jQuery('#trigger-schedule-link').click();", 200);
            }
        });
        jQuery('#run_list .close_btn, #run_list .cancel-btn').on('click', function(){
            location.reload();
        });
        jQuery('#refresh_trigger_data, .change_status').off('click').on('click', function(){
            changeStatus(jQuery(this).attr('data-status'), jQuery(this).attr('data-prevstatus'), jQuery(this).attr('data-runid'));
        });
        function changeStatus(status, prevstatus, runid)
        {
            jQuery('.loading_schedule').show();
            jQuery.ajax({
                url: '/',
                type: 'post',
                data: { 'td-action' : '<?php echo wp_create_nonce('change-schedule-status');?>', 'id' : runid, 'status' : status, 'prevstatus' : prevstatus },
                success: function(response){
                    jQuery('.loading_schedule').hide();
                    jQuery('#schedules_table').html(response);
                }
            });
        }
    });
</script>
