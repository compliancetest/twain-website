    <div class="loading loading_run"></div>
</div>
<script src="<?php echo '/wp-content/themes/bp-child/js/jquery-ui-timepicker-addon.js';?>" type="text/javascript"></script>
<script type="application/javascript">
    jQuery(document).ready(function(){
        jQuery('#datetime').datetimepicker({
            timeFormat: "H:mm",
            dateFormat: 'yy-mm-dd'
        });
        jQuery('.trigger-run').on('click', function($){
            var time = jQuery('#datetime').val();
            jQuery('.loading_run').show();
            jQuery('#datetime').removeClass('input-error');
            jQuery('.validation_error').hide();
            jQuery.ajax({
                url: '/',
                type: 'post',
                data: {
                    'td-action' : '<?php echo wp_create_nonce('execute-schedule');?>',
                    'profile_id' : '<?php echo $view->id;?>',
                    'datetime' : time
                },
                success: function(response){
                    if (response == 'success') {
                        if (window.location.href.indexOf('my-transaction-log') != -1) {
                            jQuery('.loading_run').hide();
                            setTimeout("jQuery('#trigger-schedule-link').click()", 200);
                            setTimeout("jQuery('#refresh_trigger_data').click()", 300);
                        } else {
                            location.reload();
                        }
                    } else {
                        jQuery('.loading_run').hide();
                        jQuery('#datetime').addClass('input-error');
                        jQuery('.validation_error').show();
                    }
                }
            })
        });
    });
</script>
