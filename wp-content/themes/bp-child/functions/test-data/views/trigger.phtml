<div class="popup-box" style="display: none; width: 450px;" id="trigger_run">
    <div class="popup-box-header radius6 noradiusbottom">Trigger Run</div>
    <div class="popup-box-content grid-box-body">
        <p>Do you wish to trigger this run at the selected time?</p>
        <input type="datetime" name="datetime" id="datetime">
        <div class="validation_error" style="color: red; font-size: smaller; display: none; max-width: 85%;">A run can only be scheduled to start in the future</div>
